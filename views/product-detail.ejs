<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'Detail Produk' %></title>
    <style>
      body{margin:0;font-family:Arial,sans-serif;background:#f6f1ec;color:#2d241f} .container{max-width:1100px;margin:0 auto;padding:24px 20px 60px} .top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;align-items:center} a{text-decoration:none;color:inherit}.grid{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:24px}.card{background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 10px 18px rgba(0,0,0,.06)} .card img{width:100%;height:420px;object-fit:cover}.content{padding:20px} .price{font-size:1.8rem;color:#8b562e;font-weight:700;margin:14px 0}.btn{display:inline-block;background:#7d4d2b;color:#fff;padding:12px 18px;border-radius:10px;font-weight:700;margin-top:12px} .related{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:18px;margin-top:24px}
    </style>
  </head>
  <body>
    <div class="container">
      <div class="top">
        <h1>Detail Produk</h1>
        <a href="/katalog">← Kembali ke Katalog</a>
      </div>
      <div class="grid">
        <div class="card">
          <img src="<%= product.image || '/images/product-default.jpg' %>" alt="<%= product.name %>" />
        </div>
        <div class="card content">
          <h2><%= product.name %></h2>
          <div class="price"><%= formatRupiah ? formatRupiah(product.price) : 'Rp ' + product.price %></div>
          <p><strong>Kategori:</strong> <%= product.categoryName || product.category %></p>
          <p><strong>Spesifikasi:</strong> <%= product.specs || '-' %></p>
          <p><%= product.description || 'Deskripsi produk belum tersedia.' %></p>
          <a class="btn" href="<%= waLink %>" target="_blank" rel="noreferrer">Pesan via WhatsApp</a>
        </div>
      </div>

      <% if (relatedProducts && relatedProducts.length) { %>
        <h3 style="margin-top:30px;">Produk Terkait</h3>
        <div class="related">
          <% relatedProducts.forEach((item) => { %>
            <div class="card">
              <img src="<%= item.image || '/images/product-default.jpg' %>" alt="<%= item.name %>" />
              <div class="content">
                <h4><a href="/produk/<%= item.id %>"><%= item.name %></a></h4>
                <div class="price" style="font-size:1.1rem;"><%= formatRupiah ? formatRupiah(item.price) : 'Rp ' + item.price %></div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </body>
</html>
