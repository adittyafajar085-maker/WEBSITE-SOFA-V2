<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'Login Admin' %></title>
    <style>
      body { font-family: Arial, sans-serif; background: #f3efe9; margin: 0; display: grid; place-items: center; min-height: 100vh; }
      .card { background: white; width: min(420px, 90vw); border-radius: 18px; box-shadow: 0 16px 35px rgba(0,0,0,0.09); padding: 30px; }
      h1 { margin-top: 0; }
      input { width: 100%; box-sizing: border-box; padding: 12px 14px; margin: 8px 0 16px; border: 1px solid #ddd; border-radius: 10px; }
      button { width: 100%; border: none; background: #6b3f1d; color: white; border-radius: 10px; padding: 13px 16px; font-size: 1rem; font-weight: 700; cursor: pointer; }
      .alert { background: #fff3f3; border: 1px solid #f5c1c1; color: #a12d2d; padding: 10px 12px; border-radius: 8px; margin-bottom: 18px; }
      .success { background: #ebf8ee; border: 1px solid #bfe1c8; color: #24663b; }
      .link { margin-top: 16px; text-align: center; }
      .link a { color: #6b3f1d; font-weight: bold; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Login Admin</h1>
      <% if (error) { %>
        <div class="alert"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert success"><%= success %></div>
      <% } %>
      <form method="POST" action="/login">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" placeholder="admin@adittyaputra.com" required />

        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Masukkan password" required />

        <button type="submit">Masuk</button>
      </form>
      <div class="link"><a href="/">Kembali ke Beranda</a></div>
    </div>
  </body>
</html>
